{
  "$schema": "https://unpkg.com/wrangler@4.136.3/config-schema.json",
  "name": "parkst-chart-lab",
  "compatibility_date": "2026-09-23",
  "workers_dev": true,
  "build": {
    "command": "node scripts/build-cloudflare.mjs"
  },
  "assets": {
    "directory": "./dist",
    "html_handling": "none",
    "not_found_handling": "404-page"
  }
}
